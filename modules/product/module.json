{
    "name": "product",
    "version": "1.0.0",
    "description": "Sản phẩm (product) — list + detail render bằng Stempler + dashboard CRUD.",
    "type": "data",
    "priority": 46,
    "enabled": true,
    "depends": [],
    "providers": [
        "Modules\\Product\\Providers\\ProductServiceProvider"
    ],
    "autoload": {
        "psr-4": {
            "Modules\\Product\\": "src/"
        }
    },
    "provides": ["product.data"],
    "admin": {
        "group": "Nội dung",
        "group_icon": "📦",
